PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Leave DATABASE_URL empty to keep the catalog in memory (no database needed).
DATABASE_URL=postgres://glasses_app:local_dev_only_change_me@localhost:5432/glasses

# Required for POST/PATCH/DELETE on /api/glasses (send it as "Authorization: Bearer <key>").
# Leave empty to disable catalog writes. Use a long random value in production.
ADMIN_API_KEY=change-me-local-only
